		workflow
		{
		form
		{
			calculate_net_payable_amount as "Calculate Net Payable Amount"
			{
				type =  form
				form = claim_requests

				record event = on add or edit

				on user input of claim_amount_requested
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the policy record based on the policy lookup
										policyRecord = policies[ID == input.policy_lookup];
										// Get the policy deductible amount
										policyDeductible = policyRecord.policy_deductible;
										// Get the depreciation percentage from input or set default
										if(input.depreciation_percent.isNull())
										{
											depreciationPercent = 0;
										}
										else
										{
											depreciationPercent = input.depreciation_percent;
										}
										// Convert depreciation percentage to decimal
										if(depreciationPercent > 0)
										{
											depreciationDecimal = depreciationPercent / 100;
										}
										else
										{
											depreciationDecimal = 0;
										}
										// Get the claim amount requested
										claimAmount = input.claim_amount_requested;
										// Calculate depreciation amount
										depreciationAmount = claimAmount * depreciationDecimal;
										// Calculate net payable by deducting deductible and depreciation
										netPayable = claimAmount - policyDeductible - depreciationAmount;
										// Update the net_payable_amount field in the current record
										input.net_payable_amount = netPayable;
						)
					}
				}

			}
			validate_claim_submission as "Validate Claim Submission"
			{
				type =  form
				form = claim_requests

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if declaration is checked
										if(input.is_declaration_checked == false)
										{
											alert "Please check the declaration box to proceed with the claim submission.";
											cancel submit;
										}
										// Check if documents are complete
										if(input.document_complete_flag == false)
										{
											alert "Please ensure all required documents are uploaded before submitting the claim.";
											cancel submit;
										}
						)
					}
				}

			}
			notify_on_claim_approval as "Notify on Claim Approval"
			{
				type =  form
				form = claim_requests

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the claim request record to get claimant email and name
										claimRecord = claim_requests[claim_status == "Approved" && ID == input.ID];
										// Validate that the record exists
										if(!claimRecord.isNull())
										{
											// Extract claimant details from the record
											claimantEmail = claimRecord.email_address;
											claimantName = claimRecord.claimant_name.first_name;
											claimReferenceId = claimRecord.claim_reference_id;
											// Validate email address exists
											if(!claimantEmail.isNull() && !claimantEmail.isEmpty())
											{
												// Send email notification to claimant
												sendmail
												[
													from :zoho.loginuserid
													to :claimantEmail
													subject :"Your Claim Has Been Approved - " + claimReferenceId
													message :"Dear " + claimantName + ",\n\nWe are pleased to inform you that your claim with reference number " + claimReferenceId + " has been approved.\n\nPlease contact our support team for further assistance regarding the settlement process.\n\nBest regards,\nClaims Department"
												]
											}
										}
						)
					}
				}

			}
		}




