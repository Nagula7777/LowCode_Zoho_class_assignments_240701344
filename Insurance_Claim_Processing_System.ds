 application "Insurance Claim Processing System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form claim_requests
		{
			displayname = "Claim Request Form"
			success message = "Request Claimed Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim_reference_id
			(
    			type = text
				displayname = "Claim Reference ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_name
			(
    			type = name
				displayname = "Claimant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_type
			(
				type = picklist
				displayname = "Claimant Type"
				values = {"Nominee","Policyholder","Third Party"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_type
			(
				type = picklist
				displayname = "Claim Type"
				values = {"Life Insurance","Travel Insurance","Property Insurance","Motor Insurance","Health Insurance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_of_incident
			(
    			type = date
				displayname = "Date Of Incident"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_amount_requested
			(
				type = number
				displayname = "Claim Amount Requested"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			supporting_documents
			(
				type = list	
				displayname = "Supporting Documents"
				values = {"Medical Bills","Identity Proof","Police FIR Copy","Photographs","Repair Estimate"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_description
			(
    			type = textarea
				displayname = "Incident Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_callback_time
			(
    			type = time
				displayname = "Preferred Callback Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_declaration_checked
			(
    			type = checkbox
				displayname = "Declaration Of Authenticity"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_lookup
			(
				type = picklist	
				displayname = "Policy Details"
				values  = policies.ID
    			displayformat = [policy_number]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			damage_photo
			(
    			type = text
				displayname = "Damage Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			repair_estimate_file
			(
    			type = text
				displayname = "Repair Estimate Upload"
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_sum_insured
			(
				type = decimal
				displayname = "Policy Sum Insured Lakhs"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			fir_online_link
			(
    			type = url
				displayname = "FIR Copy Online Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			accident_video
			(
    			type = text
				displayname = "Accident Scene Video"
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_audio
			(
    			type = text
				displayname = "Incident Voice Statement"
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_third_party_involved
			(
    			type = checkbox
				displayname = "Is Third Party Involved"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_repair_cost
			(
				displayname = "Estimated Repair Cost"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			depreciation_percent
			(
    			type = percentage
				displayname = "Depreciation Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_payable_amount
			(
				displayname = "Net Payable Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_signature
			(
    			type = text
				displayname = "Claimant Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_submitted_on
			(
    			type = datetime
				displayname = "Claim Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_status
			(
				type = picklist
				displayname = "Claim Status"
				values = {"Submitted","Document Verification","Under Investigation","Pending Senior Approval","Approved","Rejected","Settled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			investigation_status
			(
				type = picklist
				displayname = "Investigation Status"
				values = {"Completed","In Progress","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			surveyor_assigned
			(
    			type = text
				displayname = "Surveyor Assigned"
	 			row = 1
	 			column = 1   
				width = medium
			)
			settlement_status
			(
				type = picklist
				displayname = "Settlement Status"
				values = {"Failed","Paid","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			missing_documents_flag
			(
    			type = checkbox
				displayname = "Missing Documents Flag"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			document_complete_flag
			(
    			type = checkbox
				displayname = "Document Complete"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			reminder_count
			(
				type = number
				displayname = "Reminder Count"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Claim Submitted","Initial Review","Claim Rejected","Document Verification","Investigation Required","Surveyor Assignment","Survey In Progress","Damage Assessment","Estimation Review","Approval Pending","Settlement Approved","Settlement Rejected","Payment Processing","Claim Closed","Payment Completed","Payment Failed","Investigation Complete"}
			}
		}
		form policies
		{
			displayname = "Master Policies"
			success message = "Master Policies Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			policy_number
			(
    			type = text
				displayname = "Policy Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			holder_name
			(
    			type = name
				displayname = "Holder Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			coverage_type
			(
				type = picklist
				displayname = "Coverage Type"
				values = {"Health","Life","Third Party","Comprehensive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			sum_insured_lakhs
			(
				type = decimal
				displayname = "Sum Insured Lakhs"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			valid_till
			(
    			type = date
				displayname = "Valid Till"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_deductible
			(
				displayname = "Policy Deductible"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_status
			(
				type = picklist
				displayname = "Policy Status"
				values = {"Active","Expired","Cancelled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			issuing_branch
			(
    			type = text
				displayname = "Issuing Branch"
	 			row = 1
	 			column = 1   
				width = medium
			)
			renewal_date
			(
    			type = date
				displayname = "Renewal Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			premium_amount
			(
				displayname = "Premium Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form witness_records
		{
			displayname = "Witness Details"
			success message = "Witness Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			witness_name
			(
    			type = name
				displayname = "Witness Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			witness_contact
			(
    			type = phonenumber
				displayname = "Witness Contact"
	 			row = 1
	 			column = 1   
				width = medium
			)
			witness_statement
			(
    			type = textarea
				displayname = "Witness Statement"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_reference
			(
				type = picklist	
				displayname = "Claim Reference"
				values  = claim_requests.ID
    			displayformat = [claim_reference_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list claim_requests_Report
		{
			displayName = "All Requests"
			show all rows from claim_requests    
			(
				claim_reference_id as "Claim Reference ID"
				claimant_name  as "Claimant Name"
				claimant_type as "Claimant Type"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				claim_type as "Claim Type"
				date_of_incident as "Date Of Incident"
				claim_amount_requested as "Claim Amount Requested"
				supporting_documents as "Supporting Documents"
				incident_description as "Incident Description"
				preferred_callback_time as "Preferred Callback Time"
				is_declaration_checked as "Declaration Of Authenticity"
				policy_lookup as "Policy Details"
				damage_photo as "Damage Photo"
				repair_estimate_file as "Repair Estimate Upload"
				policy_sum_insured as "Policy Sum Insured Lakhs"
				fir_online_link as "FIR Copy Online Link"
				accident_video as "Accident Scene Video"
				incident_audio as "Incident Voice Statement"
				is_third_party_involved as "Is Third Party Involved"
				estimated_repair_cost as "Estimated Repair Cost"
				(
					display = total,average,min,max	
				)
				depreciation_percent as "Depreciation Percent"
				(
					display = total,average,min,max	
				)
				net_payable_amount as "Net Payable Amount"
				(
					display = total,average,min,max	
				)
				claimant_signature as "Claimant Digital Signature"
				claim_submitted_on as "Claim Submitted On"
				claim_status as "Claim Status"
				investigation_status as "Investigation Status"
				surveyor_assigned as "Surveyor Assigned"
				settlement_status as "Settlement Status"
				missing_documents_flag as "Missing Documents Flag"
				document_complete_flag as "Document Complete"
				reminder_count as "Reminder Count"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (claimant_type == "Nominee")
				fields = [claimant_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (claimant_type == "Third Party")
				fields = [claimant_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban claim_requests_by_claim_status
		{
			displayName = "Claim Statuses"
			show all rows from claim_requests    
			(
				claim_reference_id as "Claim Reference ID"
				claimant_name  as "Claimant Name"
				claimant_type as "Claimant Type"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				claim_type as "Claim Type"
				date_of_incident as "Date Of Incident"
				claim_amount_requested as "Claim Amount Requested"
				supporting_documents as "Supporting Documents"
				incident_description as "Incident Description"
				preferred_callback_time as "Preferred Callback Time"
				is_declaration_checked as "Declaration Of Authenticity"
				policy_lookup as "Policy Details"
				damage_photo as "Damage Photo"
				repair_estimate_file as "Repair Estimate Upload"
				policy_sum_insured as "Policy Sum Insured Lakhs"
				fir_online_link as "FIR Copy Online Link"
				accident_video as "Accident Scene Video"
				incident_audio as "Incident Voice Statement"
				is_third_party_involved as "Is Third Party Involved"
				estimated_repair_cost as "Estimated Repair Cost"
				(
					display = total,average,min,max	
				)
				depreciation_percent as "Depreciation Percent"
				(
					display = total,average,min,max	
				)
				net_payable_amount as "Net Payable Amount"
				(
					display = total,average,min,max	
				)
				claimant_signature as "Claimant Digital Signature"
				claim_submitted_on as "Claim Submitted On"
				claim_status as "Claim Status"
				investigation_status as "Investigation Status"
				surveyor_assigned as "Surveyor Assigned"
				settlement_status as "Settlement Status"
				missing_documents_flag as "Missing Documents Flag"
				document_complete_flag as "Document Complete"
				reminder_count as "Reminder Count"
			)
			options
			(
	 			display field = claim_status
	 		)
		}
		list policies_Report
		{
			displayName = "All Master Policies"
			show all rows from policies    
			(
				policy_number as "Policy Number"
				holder_name  as "Holder Name"
				coverage_type as "Coverage Type"
				sum_insured_lakhs as "Sum Insured Lakhs"
				valid_till as "Valid Till"
				policy_deductible as "Policy Deductible"
				(
					display = total,average,min,max	
				)
				policy_status as "Policy Status"
				issuing_branch as "Issuing Branch"
				renewal_date as "Renewal Date"
				premium_amount as "Premium Amount"
				(
					display = total,average,min,max	
				)
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (coverage_type == "Comprehensive")
				fields = [coverage_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (coverage_type == "Life")
				fields = [coverage_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (coverage_type == "Third Party")
				fields = [coverage_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban policies_by_coverage_type
		{
			displayName = "Coverage Types"
			show all rows from policies    
			(
				policy_number as "Policy Number"
				holder_name  as "Holder Name"
				coverage_type as "Coverage Type"
				sum_insured_lakhs as "Sum Insured Lakhs"
				valid_till as "Valid Till"
				policy_deductible as "Policy Deductible"
				(
					display = total,average,min,max	
				)
				policy_status as "Policy Status"
				issuing_branch as "Issuing Branch"
				renewal_date as "Renewal Date"
				premium_amount as "Premium Amount"
				(
					display = total,average,min,max	
				)
			)
			options
			(
	 			display field = coverage_type
	 		)
		}
		list witness_records_Report
		{
			displayName = "All Witness Details"
			show all rows from witness_records    
			(
				witness_name  as "Witness Name"
				witness_contact as "Witness Contact"
				witness_statement as "Witness Statement"
				claim_reference as "Claim Reference"
			)
		}
	}
	pages
	{
		page DashBoard
